# Copy to .env (ignored by git) to override defaults. All variables are optional.

# Port of the user interface (Vite in development). The local API listens on CV_PORT + 1.
CV_PORT=4310

# Absolute path to the real data directory, if you keep it outside the repository.
# Default: <project>/data
# CV_DATA_DIR=D:\Donnees\cv-data

# Folder containing pdftotext.exe and pdffonts.exe (Poppler for Windows), if not on PATH.
# POPPLER_BIN=C:\Tools\poppler-26.09.0\Library\bin

# Accept a single text extractor (pdf.js) when Poppler is missing: the ATS report is marked "incomplet".
# ATS_SINGLE_EXTRACTOR=1

# --- Production mode and online instance (ADR 0018) ---
# Public origin of the online instance (https, no path): enables the passkey sign-in. Set on the server
# by the deployment tooling; leave unset locally.
# CV_PUBLIC_ORIGIN=https://cv.example.org
# Absolute folders (default: import/, out/ and auth/ at the project root).
# CV_IMPORT_DIR=/path/to/cv/import
# CV_OUT_DIR=/path/to/cv/out
# CV_AUTH_DIR=/path/to/cv/auth

# npm run deploy (private tooling, not in the public repository): SSH host (~/.ssh/config, security key only) and public origin of the instance.
# CV_DEPLOY_HOST=my-server
# CV_DEPLOY_ORIGIN=https://cv.example.org
